# --- API ---
PORT=3000

# development | production | test. Gates the auth cookie's Secure flag, so on a
# deployed box this MUST be exactly 'production' — the value is validated at boot
# so a typo fails loudly instead of silently shipping a cookie without Secure.
NODE_ENV=development

# Comma-separated browser origins allowed to call the API with credentials.
# Locally that is the Angular dev server. In production leave it EMPTY: nginx
# serves the app and proxies /api from the same hostname, so nothing legitimate
# is cross-origin and an allowlist entry would only widen what a hostile page
# can do with a logged-in viewer's cookie.
CORS_ORIGIN=http://localhost:4200

# --- Domain DB (PostgreSQL + TimescaleDB) ---
# DB_HOST is 'localhost' when running the API on the host, 'timescaledb' inside compose.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=telemetry
DB_PASSWORD=change_me
DB_DATABASE=telemetry

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRATION=3600

# --- Redis (live pub/sub + last-known-value cache) ---
# REDIS_HOST is 'localhost' when running on the host, 'redis' inside compose.
REDIS_HOST=localhost
REDIS_PORT=6379
# Blank locally — the compose Redis is not reachable off the container network.
# Set it on any deployed box.
REDIS_PASSWORD=

# --- Deploy (docker-compose.prod.yaml only) -------------------------------
# Not read by the Node apps — these drive nginx, certbot and the broker's TLS
# listener. The browser and the car reach the same hostname; the car just uses
# mqtts://<PUBLIC_DOMAIN>:8883 instead of https://<PUBLIC_DOMAIN>.
# Locally, deploy/dev-certs.sh mints a self-signed cert for whatever you set here
# (default telemetry.local) so the prod stack can be rehearsed before a VPS
# exists. See DEPLOY.md.
PUBLIC_DOMAIN=telemetry.example.com
LETSENCRYPT_EMAIL=you@example.com

# --- MQTT broker ---
# The broker rejects anonymous connections; run scripts/init-mosquitto-dynsec.sh
# once (before the first `docker compose up`) to create these two accounts.
MQTT_URL=mqtt://localhost:1883

# telemetry-ingest's own account — subscribe-only over cars/+/#
MQTT_USERNAME=telemetry-ingest
MQTT_PASSWORD=change_me_to_a_long_random_string

# Dynamic-security admin — used only by the API to provision per-car accounts.
# Never give this to a device. docker-compose blanks these for telemetry-ingest,
# which has no use for them.
MQTT_ADMIN_USERNAME=dynsec-admin
MQTT_ADMIN_PASSWORD=change_me_to_a_different_long_random_string

# --- Track map overlay (apps/api only) ---
# Fetches a circuit's outline from the public Overpass API once per track,
# ever, and caches it in track_maps. No key needed — nothing here is a secret.
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_USER_AGENT=motorsport-telemetry-cloud (contact via repository)
OVERPASS_TIMEOUT_MS=20000
OVERPASS_SEARCH_RADIUS_M=2000
TRACK_MAP_FETCH_DEADLINE_MS=8000
TRACK_MAP_RETRY_AFTER_HOURS=24
TRACK_MAP_FETCH_ENABLED=true
