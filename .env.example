# --- API ---
PORT=3000
NODE_ENV=development

# --- Domain DB (PostgreSQL + TimescaleDB) ---
# DB_HOST is 'localhost' when running the API on the host, 'timescaledb' inside compose.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=telemetry
DB_PASSWORD=change_me
DB_DATABASE=telemetry

# --- Auth ---
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRATION=3600

# --- Redis (Phase 3) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- MQTT broker ---
MQTT_URL=mqtt://localhost:1883
