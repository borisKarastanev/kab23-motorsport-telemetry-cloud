node_modules
dist
coverage
frontend
.git

# Secrets must never be baked into an image layer — they are passed at runtime
# via env_file / secret mounts, and an image layer survives deleting the file.
.env
.env.*
!.env.example

# `*.pem` alone is not enough: a .dockerignore `*` does not cross a `/`, so it
# matches only the context root. The TLS material under deploy/ needs both the
# recursive form and the directory itself.
*.pem
*.key
*.p12
**/*.pem
**/*.key
**/*.p12
deploy/certbot
deploy/mosquitto

mosquitto/config/passwd
CLAUDE.md
